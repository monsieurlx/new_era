## MODULE 10: scanner.py

PURPOSE: Main orchestrator. Runs the full pipeline end to end.

```
async function run_scanner(cfg: dict) -> pd.DataFrame:

    # Step 1: Universe
    tickers = get_tickers(cfg)                        # universe.py
    print(f"Universe: {len(tickers)} tickers")

    # Step 2: IB Connection + Data
    client = IBClient(cfg)
    await client.connect()

    spy_df  = await client.fetch_historical(make_stock_contract("SPY"), ...)
    vix_s   = await client.fetch_vix(cfg)
    data    = await client.fetch_all_historical(tickers, cfg)

    await client.disconnect()

    # Step 3: Regime
    regime = detect_regime(spy_df, vix_s, cfg)        # regime.py
    print_regime(regime)

    # Step 4: Benchmark RS
    spy_close  = spy_df["close"]

    # Step 5: Score each ticker
    results = []
    rejected = defaultdict(int)

    for ticker, df in data.items():

        # Compute indicators
        inds = calc_all(df, cfg)                      # indicators.py
        inds["close_last"] = df["close"].iloc[-1]

        # Hard filters
        passes, reason = apply_all_filters(ticker, df, inds, cfg)   # filters.py
        if not passes:
            rejected[reason] += 1
            continue

        # Relative strength
        rs_scores = [
            df["close"].pct_change(w).iloc[-1] - spy_close.pct_change(w).iloc[-1]
            for w in cfg["rs_windows"]
            if len(df) >= w
        ]

        # Patterns
        pattern = detect_best_pattern(df, inds, cfg)  # patterns.py

        # Risk
        risk = compute_risk(df, inds, pattern, cfg)   # risk.py

        # Score
        score_data = score_ticker(                    # scorer.py
            ticker, df, inds, pattern, rs_scores, regime, cfg
        )
        # Inject R:R score component
        c_rr = min(max((risk["rr"] - 2) / 3, 0), 1.0) if risk["valid"] else 0.0
        score_data["score"] += c_rr × cfg["score_weights"]["rr"] × 100

        # Combine
        row = {**score_data, **risk}
        results.append(row)

    # Step 6: Sort and return
    df_out = pd.DataFrame(results).sort_values("score", ascending=False).reset_index(drop=True)
    df_out.index += 1

    # Print summary
    print_summary(df_out, regime, cfg)

    # Save
    df_out.to_csv("swing_results.csv", index=True)
    print(f"\nPassed: {len(results)} | Rejected: {sum(rejected.values())}")
    print(f"Rejection reasons: {dict(rejected)}")

    return df_out
```

