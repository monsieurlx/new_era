## MODULE 6: filters.py

PURPOSE: Hard binary filters. Return True = passes, False = drop.

```
function passes_liquidity(df: pd.DataFrame, cfg: dict) -> bool:
    price    = df["close"].iloc[-1]
    avg_vol  = df["volume"].rolling(20).mean().iloc[-1]
    dol_vol  = (df["close"] × df["volume"]).rolling(20).mean().iloc[-1]

    return (
        cfg["min_price"] <= price <= cfg["max_price"]
        AND avg_vol >= cfg["min_avg_volume"]
        AND dol_vol >= cfg["min_dollar_volume"]
    )

function passes_trend(inds: dict, cfg: dict) -> tuple[bool, int]:
    # Returns (passes: bool, conditions_met: int out of 5)
    s20  = inds["sma20"].iloc[-1]
    s50  = inds["sma50"].iloc[-1]
    s200 = inds["sma200"].iloc[-1]
    p    = inds["close_last"]     # scalar, pass in from df["close"].iloc[-1]
    adx  = inds["adx"].iloc[-1]
    slope50 = (inds["sma50"].iloc[-1] / inds["sma50"].iloc[-10] - 1) × 100

    conditions = [
        p > s20,
        s20 > s50,
        s50 > s200,
        slope50 > 0,
        adx > cfg["adx_min"],
    ]
    met = sum(conditions)
    return met >= cfg["min_trend_conditions"], met

function passes_volatility(inds: dict, cfg: dict) -> bool:
    atr_pct = inds["atr_pct"].iloc[-1]
    return cfg["atr_pct_min"] <= atr_pct <= cfg["atr_pct_max"]

function apply_all_filters(ticker, df, inds, cfg) -> tuple[bool, str]:
    # Returns (passes: bool, rejection_reason: str)
    if len(df) < cfg["min_bars_required"]:
        return False, "insufficient_bars"
    if not passes_liquidity(df, cfg):
        return False, "liquidity"
    if not passes_volatility(inds, cfg):
        return False, "volatility"
    trend_ok, trend_count = passes_trend(inds, cfg)
    if not trend_ok:
        return False, f"trend_{trend_count}_of_5"
    return True, "ok"
```

