## MODULE 8: scorer.py

PURPOSE: Compute composite score from all signals. Apply regime multiplier.

```
function score_ticker(ticker, df, inds, pattern_result, rs_scores, regime, cfg) -> dict:

    # --- Individual component scores (each 0.0 – 1.0) ---

    # Trend (count of 5 conditions met / 5)
    _, trend_count = passes_trend(inds, cfg)     # import from filters.py
    c_trend = trend_count / 5

    # RSI (distance from ideal = 60)
    rsi_val = inds["rsi"].iloc[-1]
    c_rsi   = max(1 - abs(rsi_val - 60) / 30, 0) if 40 < rsi_val < 80 else 0.1

    # ATR fit (distance from ideal = 4.5%)
    atr_pct = inds["atr_pct"].iloc[-1]
    c_atr   = max(1 - abs(atr_pct - cfg["atr_pct_ideal"]) / 3, 0)

    # Relative volume
    avg_vol = df["volume"].rolling(20).mean().iloc[-1]
    rvol    = df["volume"].iloc[-1] / (avg_vol + 1e-1)
    c_rvol  = min(max((rvol - 1) / 2, 0), 1.0)

    # Relative strength (average of all windows)
    rs_avg  = mean(rs_scores) if rs_scores else 0.0
    c_rs    = min(max(rs_avg × 10 + 0.5, 0), 1.0)

    # Pattern quality (from patterns.py)
    c_pattern = pattern_result["score"]

    # OBV slope
    obv_slope = (inds["obv"].iloc[-1] - inds["obv"].iloc[-10]) / (abs(inds["obv"].iloc[-10]) + 1e-10)
    c_obv = 1.0 if obv_slope > 0 else 0.0

    # Risk:Reward (computed here before risk module)
    # Pass risk_result into this function OR compute inline
    # Use a placeholder: c_rr = 0 if no valid R:R, else normalize
    # Actual R:R computed in risk.py — pass in as parameter
    c_rr = 0.0  # set externally after risk.py computes

    # --- Weighted composite ---
    w = cfg["score_weights"]
    composite = (
        w["trend"]   × c_trend  +
        w["rsi"]     × c_rsi    +
        w["atr_fit"] × c_atr    +
        w["rvol"]    × c_rvol   +
        w["rs"]      × c_rs     +
        w["pattern"] × c_pattern+
        w["rr"]      × c_rr     +
        w["obv"]     × c_obv
    ) × 100

    # --- Regime multiplier ---
    composite × = cfg["regime_multipliers"].get(regime["trend"], 1.0)
    if regime["vix"] and regime["vix"] > cfg["vix_high_threshold"]:
        composite × = cfg["vix_high_multiplier"]

    return {
        "ticker":         ticker,
        "score":          round(composite, 1),
        "c_trend":        round(c_trend, 3),
        "c_rsi":          round(c_rsi, 3),
        "c_atr":          round(c_atr, 3),
        "c_rvol":         round(c_rvol, 3),
        "c_rs":           round(c_rs, 3),
        "c_pattern":      round(c_pattern, 3),
        "c_obv":          round(c_obv, 3),
        "trend_count":    trend_count,
        "rsi":            round(rsi_val, 1),
        "atr_pct":        round(atr_pct, 2),
        "rvol":           round(rvol, 2),
        "pattern":        pattern_result["type"],
        "pattern_score":  pattern_result["score"],
    }
```

