## MODULE 7: patterns.py

PURPOSE: Detect the three swing entry patterns. Return flag and quality score.

```
function detect_breakout(df: pd.DataFrame, inds: dict, cfg: dict) -> dict:

    n        = cfg["consolidation_days"]
    base     = df.iloc[-(n+1):-1]   # exclude today
    today    = df.iloc[-1]

    base_high  = base["high"].max()
    base_low   = base["low"].min()
    base_range = base_high / base_low - 1

    if base_range > cfg["consolidation_tight"]:
        return {"flag": False, "score": 0.0, "type": "breakout"}

    avg_vol_20 = df["volume"].rolling(20).mean().iloc[-1]
    base_avg_vol = base["volume"].mean()
    base_vol_ratio = base_avg_vol / (avg_vol_20 + 1e-1)

    breakout_price = today["close"] > base_high × (1 + cfg["breakout_buffer_pct"])
    rvol           = today["volume"] / (base_avg_vol + 1e-1)

    if not breakout_price OR rvol < cfg["rvol_threshold"]:
        return {"flag": False, "score": 0.0, "type": "breakout"}

    tightness_score = 1 - (base_range / cfg["consolidation_tight"])
    length_score    = min(n / 30, 1.0)
    volume_score    = min((rvol - 1) / 2, 1.0)
    quiet_score     = max(1 - base_vol_ratio, 0)
    quality         = mean([tightness_score, length_score, volume_score, quiet_score])

    return {
        "flag":          True,
        "score":         round(quality, 3),
        "type":          "breakout",
        "base_range_pct": round(base_range × 100, 2),
        "base_length":   n,
        "rvol":          round(rvol, 2),
    }


function detect_pullback(df: pd.DataFrame, inds: dict, cfg: dict) -> dict:

    close  = df["close"]
    sma50  = inds["sma50"]
    ema20  = inds["ema20"]
    rsi    = inds["rsi"]

    price_above_50  = close.iloc[-1] > sma50.iloc[-1]
    sma50_sloping   = sma50.iloc[-1] > sma50.iloc[-10]

    if not (price_above_50 AND sma50_sloping):
        return {"flag": False, "score": 0.0, "type": "pullback"}

    recent_high  = df["high"].iloc[-20:].max()
    pullback_pct = (recent_high - close.iloc[-1]) / recent_high

    if not (cfg["pullback_min_pct"] <= pullback_pct <= cfg["pullback_max_pct"]):
        return {"flag": False, "score": 0.0, "type": "pullback"}

    ema_dist = abs(close.iloc[-1] - ema20.iloc[-1]) / ema20.iloc[-1]
    if ema_dist > cfg["pullback_ema_touch"]:
        return {"flag": False, "score": 0.0, "type": "pullback"}

    rsi_val = rsi.iloc[-1]
    if not (cfg["pullback_rsi_min"] < rsi_val < cfg["pullback_rsi_max"]):
        return {"flag": False, "score": 0.0, "type": "pullback"}

    avg_vol    = df["volume"].rolling(20).mean().iloc[-1]
    pull_rvol  = df["volume"].iloc[-3:].mean() / (avg_vol + 1e-1)
    reversal   = close.iloc[-1] > df["high"].iloc[-2]

    depth_score    = max(1 - abs(pullback_pct - 0.07) / 0.05, 0)
    ema_score      = max(1 - ema_dist / cfg["pullback_ema_touch"], 0)
    rsi_score      = max(1 - abs(rsi_val - 52) / 12, 0)
    reversal_score = 1.0 if reversal else 0.5
    quiet_score    = 1.0 if pull_rvol < 1.0 else 0.3

    quality = mean([depth_score, ema_score, rsi_score, reversal_score, quiet_score])

    return {
        "flag":          True,
        "score":         round(quality, 3),
        "type":          "pullback",
        "pullback_pct":  round(pullback_pct × 100, 2),
        "rsi":           round(rsi_val, 1),
        "ema_dist_pct":  round(ema_dist × 100, 2),
        "reversal":      reversal,
    }


function detect_squeeze(df: pd.DataFrame, inds: dict, cfg: dict) -> dict:

    bw       = inds["bb_bw"]
    lookback = cfg["squeeze_lookback"]

    if len(bw.dropna()) < lookback:
        return {"flag": False, "score": 0.0, "type": "squeeze"}

    threshold = bw.rolling(lookback).quantile(cfg["squeeze_percentile"]).iloc[-1]
    squeeze   = bw.iloc[-1] <= threshold

    if not squeeze:
        return {"flag": False, "score": 0.0, "type": "squeeze"}

    # Score: how tight is the squeeze?
    p75   = bw.rolling(lookback).quantile(0.75).iloc[-1]
    score = max(1 - (bw.iloc[-1] / (threshold + 1e-10)), 0)
    score = min(score, 1.0)

    return {"flag": True, "score": round(score, 3), "type": "squeeze"}


function detect_best_pattern(df, inds, cfg) -> dict:
    bo = detect_breakout(df, inds, cfg)
    pb = detect_pullback(df, inds, cfg)
    sq = detect_squeeze(df, inds, cfg)

    candidates = [bo, pb, sq]
    best = max(candidates, key=lambda x: x["score"])

    if best["score"] == 0.0:
        return {"flag": False, "score": 0.0, "type": "none"}
    return best
```

