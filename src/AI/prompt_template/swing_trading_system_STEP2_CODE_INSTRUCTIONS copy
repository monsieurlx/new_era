## MODULE 5: regime.py

PURPOSE: Classify overall market regime from SPY and VIX data.

```
function detect_regime(spy_df: pd.DataFrame, vix_series: pd.Series, cfg: dict) -> dict:

    close  = spy_df["close"]
    sma50  = calc_sma(close, 50).iloc[-1]
    sma200 = calc_sma(close, 200).iloc[-1]
    sma50_prev = calc_sma(close, 50).iloc[-10]
    slope  = (sma50 / sma50_prev - 1) × 100
    price  = close.iloc[-1]

    if price > sma200 AND sma50 > sma200 AND slope > 0:
        trend = "bull"
    elif price < sma200 AND sma50 < sma200:
        trend = "bear"
    else:
        trend = "neutral"

    vix = vix_series.iloc[-1] if len(vix_series) > 0 else None

    if vix is None:
        vix_regime = "unknown"
        size_mult = cfg["regime_multipliers"][trend]
    elif vix < 18:
        vix_regime = "low"
        size_mult = cfg["regime_multipliers"][trend] × 1.0
    elif vix < 25:
        vix_regime = "normal"
        size_mult = cfg["regime_multipliers"][trend] × 1.0
    elif vix < 30:
        vix_regime = "elevated"
        size_mult = cfg["regime_multipliers"][trend] × 0.75
    else:
        vix_regime = "high"
        size_mult = cfg["regime_multipliers"][trend] × cfg["vix_high_multiplier"]

    return {
        "trend":      trend,       # "bull" | "bear" | "neutral"
        "vix":        vix,
        "vix_regime": vix_regime,
        "size_mult":  size_mult,
        "spy_price":  price,
        "sma50":      sma50,
        "sma200":     sma200,
        "slope50":    slope,
    }
```

